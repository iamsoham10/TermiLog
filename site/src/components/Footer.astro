---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-border py-10">
  <div
    class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-6 text-sm text-muted sm:flex-row"
  >
    <p>© {year} {site.name}</p>

    <div class="flex items-center gap-6">
     <a
        href={site.openTuiUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="transition-colors hover:text-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        OpenTUI
      </a>
    </div>
  </div>
</footer>
