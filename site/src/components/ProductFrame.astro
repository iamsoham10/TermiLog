---
interface Props {
  title?: string;
  variant: 'editor' | 'dashboard' | 'graphs';
  imageSrc?: string;
  alt?: string;
}

const { title = 'termilog', variant, imageSrc, alt = 'Termilog' } = Astro.props;

const heatmapCells = Array.from({ length: 52 }, (_, i) => {
  const intensity = [1, 2, 3, 4, 0, 2, 3, 1, 4, 2, 0, 1, 3, 4, 2, 1, 0, 3, 2, 4, 1, 3, 0, 2, 4, 1, 3, 2, 0, 4, 1, 2, 3, 0, 4, 2, 1, 3, 0, 2, 4, 1, 3, 2, 0, 4, 1, 2, 3, 0, 4, 2][i];
  const opacity = intensity === 0 ? 0.15 : 0.25 + intensity * 0.2;
  return opacity;
});

const moodWeek = [
  { emoji: '🙂', score: 4, label: 'S' },
  { emoji: '😊', score: 5, label: 'M' },
  { emoji: '😐', score: 3, label: 'T' },
  { emoji: '😔', score: 2, label: 'W' },
  { emoji: '🙂', score: 4, label: 'T' },
  { emoji: '😊', score: 5, label: 'F' },
  { emoji: '😐', score: 3, label: 'S' },
];
const CHART_HEIGHT = 5;
---

<div
  class="overflow-hidden rounded-xl border border-border bg-surface shadow-xl shadow-black/30"
  role="img"
  aria-label={alt}
>
  <div class="flex items-center gap-2 border-b border-border px-4 py-2.5">
    <span class="size-2.5 rounded-full bg-[#ff5f57]" aria-hidden="true"></span>
    <span class="size-2.5 rounded-full bg-[#febc2e]" aria-hidden="true"></span>
    <span class="size-2.5 rounded-full bg-[#28c840]" aria-hidden="true"></span>
    <span class="ml-2 font-mono text-xs text-muted">{title}</span>
  </div>

  <div class="aspect-video overflow-hidden bg-bg">
    {
      imageSrc ? (
        <img src={imageSrc} alt={alt} class="size-full object-cover object-top" />
      ) : (
        <div class="flex size-full items-center justify-center p-4">
          {
            variant === 'editor' && (
              <div class="flex size-full max-w-md gap-3 font-mono text-xs" aria-hidden="true">
                <div class="w-1/3 space-y-2 border-r border-border pr-3 text-muted">
                  <p class="text-accent">▸ today</p>
                  <p>yesterday</p>
                  <p>mar 7</p>
                  <p>mar 6</p>
                  <p>mar 5</p>
                </div>
                <div class="flex-1 space-y-1.5 text-muted/80">
                  <p class="text-sm text-text"># Morning thoughts</p>
                  <p>Started the day with a clear mind and a hot coffee.</p>
                  <p>Three things I'm grateful for today...</p>
                  <p class="inline-block h-3 w-1.5 bg-accent animate-blink" />
                </div>
              </div>
            )
          }

          {
            variant === 'dashboard' && (
              <div class="w-full max-w-sm space-y-5 p-2" aria-hidden="true">
                <div class="flex items-end justify-between">
                  <div>
                    <p class="font-mono text-xs text-muted">current streak</p>
                    <p class="font-mono text-3xl font-medium text-accent">12</p>
                  </div>
               </div>
                <div class="grid grid-cols-13 gap-1">
                  {heatmapCells.map((opacity) => (
                    <span
                      class="aspect-square rounded-sm bg-graph-high"
                      style={`opacity: ${opacity}`}
                    />
                  ))}
                </div>
              </div>
            )
          }

          {
            variant === 'graphs' && (
              <div
                class="w-full max-w-xs rounded-lg border border-border bg-[#1a1a1a] p-4 font-mono"
                aria-hidden="true"
              >
                <p class="text-xs text-muted">Mood</p>
                <p class="mb-3 text-[10px] text-muted/70">this week</p>
                <div class="rounded border border-border bg-[#141414] p-3">
                  <div class="flex items-end justify-between gap-1">
                    {moodWeek.map((day) => (
                      <div class="flex flex-1 flex-col items-center gap-1">
                        <span class="text-sm leading-none">{day.emoji}</span>
                        <div class="flex flex-col gap-px">
                          {Array.from({ length: CHART_HEIGHT }, (_, row) => {
                            const rowFromBottom = CHART_HEIGHT - row;
                            const filled = rowFromBottom <= day.score;
                            return (
                              <span
                                class="size-2.5"
                                style={`background-color: ${filled ? '#888888' : '#141414'}`}
                              />
                            );
                          })}
                        </div>
                        <span class="text-[10px] text-muted">{day.label}</span>
                      </div>
                    ))}
                  </div>
                  <p class="mt-3 text-[10px] text-muted/70">high 😊        low 😡</p>
                </div>
              </div>
            )
          }
        </div>
      )
    }
  </div>
</div>

<style>
  .grid-cols-13 {
    grid-template-columns: repeat(13, minmax(0, 1fr));
  }
</style>
