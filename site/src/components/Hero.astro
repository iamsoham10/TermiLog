---
import { site } from '../data/site';
import Terminal from './Terminal.astro';
import InstallCommand from './InstallCommand.astro';
---

<section class="mx-auto max-w-6xl px-6 pb-12 pt-20 lg:pb-16 lg:pt-28">
  <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
    <div class="animate-fade-in-up space-y-6">
      <span
        class="inline-block rounded-full border border-border bg-surface px-3 py-1 font-mono text-xs text-muted"
      >
        TUI · Local-first · OpenTUI
      </span>

      <h1 class="text-4xl font-bold tracking-tight text-text sm:text-5xl lg:text-6xl">
        {site.tagline}
      </h1>

      <p class="max-w-lg text-lg leading-relaxed text-muted">
        Private, keyboard-driven journaling for developers.
      </p>

      <div class="flex flex-wrap gap-3">
        <button
          type="button"
          data-copy-install
          data-command={site.installCommand}
          class="rounded-md bg-accent px-5 py-2.5 text-sm font-medium text-bg transition-colors hover:bg-accent-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
          Get started
        </button>
      </div>

      <div class="max-w-md pt-2">
        <InstallCommand copyId="hero" />
      </div>
    </div>

    <div class="animate-fade-in-up lg:pl-4" style="animation-delay: 0.15s">
      <Terminal />
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('[data-copy-install]').forEach((btn) => {
    if (btn.dataset.bound) return;
    btn.dataset.bound = 'true';

    const defaultLabel = btn.textContent?.trim() ?? 'Get started';

    btn.addEventListener('click', async () => {
      const command = btn.getAttribute('data-command')?.trim();
      if (!command) return;

      try {
        await navigator.clipboard.writeText(command);
        btn.textContent = 'Copied!';
        setTimeout(() => {
          btn.textContent = defaultLabel;
        }, 2000);
      } catch {
        btn.textContent = 'Copy failed';
        setTimeout(() => {
          btn.textContent = defaultLabel;
        }, 2000);
      }
    });
  });
</script>
