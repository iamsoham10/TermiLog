---
import { site } from '../data/site';
---

<section id="privacy" class="border-y border-border bg-surface/50 py-20">
  <div class="mx-auto max-w-6xl px-6">
    <div class="mx-auto max-w-2xl text-center">
      <div
        class="mx-auto mb-6 flex size-12 items-center justify-center rounded-full border border-border bg-bg text-accent"
        aria-hidden="true"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="size-6"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"
          />
        </svg>
      </div>

      <h2 class="mb-4 text-3xl font-bold tracking-tight text-text sm:text-4xl">
        Your words never leave your machine.
      </h2>

      <p class="mb-8 text-muted">
        Termilog is completely local. No accounts, no cloud sync, no telemetry. Just you and your
        journal.
      </p>

      <ul class="mb-10 space-y-3 text-left sm:mx-auto sm:max-w-sm">
        <li class="flex items-center gap-3 text-sm text-muted">
          <span class="text-accent" aria-hidden="true">✓</span>
          No account required
        </li>
        <li class="flex items-center gap-3 text-sm text-muted">
          <span class="text-accent" aria-hidden="true">✓</span>
          No sync server — data stays on disk
        </li>
        <li class="flex items-center gap-3 text-sm text-muted">
          <span class="text-accent" aria-hidden="true">✓</span>
          Works fully offline
        </li>
      </ul>

      <a
        href={site.openTuiUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full border border-border bg-bg px-4 py-2 font-mono text-xs text-muted transition-colors hover:border-accent/50 hover:text-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        Built on OpenTUI
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
